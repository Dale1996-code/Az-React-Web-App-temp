{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Web",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/src/web/",
                "env": {
                    "VITE_API_BASE_URL": "http://localhost:3100",
                    "BROWSER": "none"
                }
            },
            "presentation": {
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Start API",
            "type": "shell",
            "command": "npm run start",
            "options": {
                "cwd": "${workspaceFolder}/src/api/",
                "env": {
                    "NODE_ENV": "development"
                }
            },
            "presentation": {
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Start API and Web",
            "dependsOn": [
                "Start API",
                "Start Web"
            ],
            "problemMatcher": []
        }
    ]
}
