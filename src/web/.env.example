# src/web/.env.example
#
# Copy this file to .env and fill in values for local development.
# Vite reads .env automatically at dev/build time.
#
# All variables must be prefixed VITE_ to be accessible in browser code.
#
# In Azure, these are injected into a temporary .env.local during the azd
# prepackage build step (see azure.yaml) — you do not set them manually.

# ---------------------------------------------------------------------------
# Optional — API & Observability
# ---------------------------------------------------------------------------

# Base URL for all API requests. Must include the scheme (http:// or https://).
# Defaults to http://localhost:3100 when blank.
# VITE_API_BASE_URL=http://localhost:3100

# Azure Application Insights connection string for frontend telemetry.
# Find it in Azure Portal > Application Insights > Overview > Connection String.
# Telemetry is disabled when this is blank.
# VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# ---------------------------------------------------------------------------
# Optional — MSAL / Azure AD Authentication
#
# Authentication is disabled when VITE_AZURE_CLIENT_ID or VITE_AZURE_TENANT_ID
# are blank. Leave them unset for pure local dev without Azure AD.
#
# To enable:
#   1. Register a Single-Page Application in Azure Portal > App registrations.
#   2. Set the Redirect URI to http://localhost:5173 (for local dev) and to
#      your deployed URL for production.
#   3. Under "Expose an API", add a scope such as "access_as_user" and note
#      the full scope URI: api://<client-id>/access_as_user
#   4. Grant the SPA app "API permissions" for that scope.
# ---------------------------------------------------------------------------

# Application (client) ID of the SPA app registration.
# VITE_AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Directory (tenant) ID — "common" works for multi-tenant; use your tenant ID for single-tenant.
# VITE_AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Full scope URI exposed by the API app registration.
# VITE_AZURE_API_SCOPE=api://<api-client-id>/access_as_user
