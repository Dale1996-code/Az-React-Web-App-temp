# src/api/.env.example
#
# Copy this file to .env and fill in the values for local development.
# The API loads .env automatically unless NODE_ENV=production.
#
# The API stores data in Google Cloud Firestore (native mode). It authenticates
# using Application Default Credentials:
#   - On Cloud Run: the service account is used automatically.
#   - Locally: run `gcloud auth application-default login` once.

# ---------------------------------------------------------------------------
# Firestore
# ---------------------------------------------------------------------------

# Google Cloud project id that owns the Firestore database.
# Optional: on Cloud Run it is resolved from the metadata server, and locally
# it comes from your active `gcloud` configuration. Set it explicitly to be safe.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Firestore database id. Optional — defaults to "(default)".
# Set this only if you created a named (non-default) Firestore database.
# FIRESTORE_DATABASE_ID=(default)

# To use the local Firestore emulator instead of a real database, set:
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Comma-separated CORS allowed origins for non-development environments.
# Not needed locally — start-dev.sh sets NODE_ENV=development, which allows all origins.
# API_ALLOW_ORIGINS=https://your-web-app.example.com

# HTTP server port. Defaults to 3100 locally; Cloud Run injects PORT=8080.
# PORT=3100

# Application Insights connection string for API telemetry.
# Telemetry is skipped when this is blank.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Role name shown in Application Insights. Defaults to "API".
# APPLICATIONINSIGHTS_ROLE_NAME=API
