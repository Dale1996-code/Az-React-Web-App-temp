# src/api/.env.example
#
# Copy this file to .env and fill in the values for local development.
# The API loads .env automatically unless NODE_ENV=production.
#
# In Azure, these values are injected as App Service environment variables
# by the Bicep infrastructure — you do not set them manually in production.
#
# Authentication: the API uses DefaultAzureCredential (managed identity in
# Azure, developer credential locally). Run `az login` before starting the
# API locally so it can authenticate with Cosmos DB.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Cosmos DB account URI. Find it in Azure Portal > Cosmos DB account > Overview > URI.
# Example: https://your-account.documents.azure.com:443/
AZURE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Cosmos DB database name. Defaults to "DalesOperations".
# AZURE_COSMOS_DATABASE_NAME=DalesOperations

# Azure Key Vault URI. When set, all vault secrets are loaded and overlaid
# onto environment variables at startup (hyphens in secret names become underscores).
# Leave blank for local dev to use env vars directly.
# AZURE_KEY_VAULT_ENDPOINT=https://your-vault.vault.azure.net/

# Azure Application Insights connection string for API telemetry.
# Find it in Azure Portal > Application Insights > Overview > Connection String.
# Telemetry is skipped when this is blank.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Role name shown in Application Insights. Defaults to "API".
# APPLICATIONINSIGHTS_ROLE_NAME=API

# Comma-separated CORS allowed origins for non-development environments.
# Not needed locally — start-dev.sh sets NODE_ENV=development, which allows all origins.
# API_ALLOW_ORIGINS=https://your-web-app.azurewebsites.net

# HTTP server port. Defaults to 3100.
# PORT=3100
