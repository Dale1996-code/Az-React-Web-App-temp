# src/api/.env.example
#
# Copy this file to .env and fill in the values for local development.
# The API loads .env automatically unless NODE_ENV=production.
#
# In Azure, these values are injected as App Service environment variables
# by the Bicep infrastructure — you do not set them manually in production.
#
# Authentication: the API uses DefaultAzureCredential (managed identity in
# Azure, developer credential locally). Run `az login` before starting the
# API locally so it can authenticate with Cosmos DB.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Cosmos DB account URI. Find it in Azure Portal > Cosmos DB account > Overview > URI.
# Must be an https:// URL. The API validates this at startup and will refuse to
# start in production if this value is missing or malformed.
# Example: https://your-account.documents.azure.com:443/
AZURE_COSMOS_ENDPOINT=https://your-account.documents.azure.com:443/

# ---------------------------------------------------------------------------
# Cosmos DB authentication — choose ONE method:
# ---------------------------------------------------------------------------
#
# Option A: Account key (required for Cloud Run / non-Azure deployments).
# Find the key in Azure Portal > Cosmos DB account > Keys > PRIMARY KEY.
# This requires disableLocalAuth=false on your Cosmos DB account.
# When AZURE_COSMOS_KEY is set it takes priority over managed-identity auth.
# AZURE_COSMOS_KEY=<your-cosmos-primary-key>
#
# Option B: Managed identity / DefaultAzureCredential (Azure-only).
# Leave AZURE_COSMOS_KEY unset. The service principal/managed identity must
# have the "Cosmos DB Built-in Data Contributor" role on the account.
# Requires disableLocalAuth=true on the Cosmos DB account.
# (This is the default Azure path — no env var needed.)

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Cosmos DB database name. Defaults to "DalesOperations".
# AZURE_COSMOS_DATABASE_NAME=DalesOperations

# Azure Key Vault URI. When set, all vault secrets are loaded and overlaid
# onto environment variables at startup (hyphens in secret names become underscores).
# Leave blank for local dev to use env vars directly.
# AZURE_KEY_VAULT_ENDPOINT=https://your-vault.vault.azure.net/

# Azure Application Insights connection string for API telemetry.
# Find it in Azure Portal > Application Insights > Overview > Connection String.
# Telemetry is skipped when this is blank.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Role name shown in Application Insights. Defaults to "API".
# APPLICATIONINSIGHTS_ROLE_NAME=API

# Comma-separated CORS allowed origins for non-development environments.
# Not needed locally — start-dev.sh sets NODE_ENV=development, which allows all origins.
# API_ALLOW_ORIGINS=https://your-web-app.azurewebsites.net

# HTTP server port. Defaults to 3100.
# PORT=3100

# ---------------------------------------------------------------------------
# Authentication (required in production, bypassed in development/test)
# ---------------------------------------------------------------------------
# When NODE_ENV=production, the API enforces Azure Entra ID Bearer JWT auth on
# all business endpoints. Both values below must be set or the API will refuse
# to start. They are not needed locally — auth is skipped automatically when
# NODE_ENV is not "production".
#
# AZURE_AD_TENANT_ID   — Azure Portal > Entra ID > Overview > "Tenant ID"
# AZURE_AD_CLIENT_ID   — The App Registration that represents the API:
#                        Azure Portal > Entra ID > App registrations > <your app> > "Application (client) ID"
#
# AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
